# ---------- База данных ----------
# Локальная разработка (npm run dev): полный URL до вашего Postgres
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/ecocraft?schema=public"

# Docker Compose (прод): URL собирается автоматически из этих трёх переменных
POSTGRES_DB="ecocraft"
POSTGRES_USER="ecocraft"
POSTGRES_PASSWORD="придумайте_длинный_пароль"

# ---------- Сайт ----------
# Публичный адрес без слэша в конце. Используется для return_url ЮKassa,
# allowedOrigins server actions, sitemap и OpenGraph. В Docker нужен на этапе сборки.
NEXT_PUBLIC_SITE_URL="https://snovaniel.ru"

# ---------- ЮKassa (личный кабинет -> Интеграция -> Ключи API) ----------
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""

# ---------- Telegram-уведомления о заказах и сообщениях (необязательно) ----------
# Создайте бота через @BotFather, напишите ему /start, chat_id узнайте через @userinfobot.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ---------- Реквизиты для оферты и политики конфиденциальности ----------
LEGAL_ENTITY="ИП Фамилия Имя Отчество"
LEGAL_INN=""
LEGAL_OGRNIP=""
LEGAL_ADDRESS=""
